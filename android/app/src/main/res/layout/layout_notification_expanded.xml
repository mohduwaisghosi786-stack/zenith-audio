<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/notif_exp_app_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_launcher_foreground"
            android:contentDescription="Zenith" />

        <TextView
            android:id="@+id/notif_exp_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Zenith Audio Controls"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_exp_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:background="@drawable/bg_status_badge" />
    </LinearLayout>

    <!-- Clean Status Text -->
    <TextView
        android:id="@+id/notif_exp_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="🟢 Stream Connected • 🎤 Microphone Active"
        android:textColor="#ECEFF1"
        android:textSize="13sp" />

    <!-- 3 Big Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 1. Mic Button -->
        <LinearLayout
            android:id="@+id/notif_exp_btn_mic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/notif_exp_ic_mic"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_notif_mic_on"
                android:contentDescription="Mic Status" />

            <TextView
                android:id="@+id/notif_exp_txt_mic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mic ON"
                android:textColor="#00E676"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Connect / Disconnect Button -->
        <LinearLayout
            android:id="@+id/notif_exp_btn_connect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/notif_exp_ic_connect"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_notif_disconnect"
                android:contentDescription="Connection Status" />

            <TextView
                android:id="@+id/notif_exp_txt_connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Disconnect"
                android:textColor="#FFB300"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Force Close Button -->
        <LinearLayout
            android:id="@+id/notif_exp_btn_close"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/notif_exp_ic_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_notif_stop"
                android:contentDescription="Force Close" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Force Close"
                android:textColor="#FF5252"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
